@startuml secuencia-autenticacion
' =============================================================================
' LiveMetric — Diagrama de Secuencia: flujo critico de autenticacion dual
' Ubicacion sugerida en el repo: docs/arquitectura/secuencia-autenticacion.puml
' Render: plantuml -tsvg docs/arquitectura/secuencia-autenticacion.puml
' =============================================================================

title LiveMetric — Secuencia de autenticacion dual (administrador y votante)

skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam sequence {
  ArrowColor #333333
  LifeLineBorderColor #999999
  ParticipantBorderColor #555555
  ParticipantBackgroundColor #FDFDFD
}

actor "Usuario" as U
participant "Frontend SPA\n(React)" as FE
participant "Auth Service\n(Express :3001)" as AUTH
database "PostgreSQL" as DB

== Camino A — Administrador o Auditor ==

U -> FE : usuario + contraseña
FE -> AUTH : POST /login/admin\n{username, password}
activate AUTH
AUTH -> AUTH : express-validator\n+ rate limiting por IP
AUTH -> DB : SELECT id, username, password_hash, role\nFROM admins WHERE username = $1
DB --> AUTH : fila del administrador (o vacio)
AUTH -> AUTH : bcrypt.compare(password, password_hash)

alt Credenciales validas
  AUTH -> AUTH : firma JWT { sub, username, role }\nexp = JWT_EXPIRES_IN (1h por defecto)
  AUTH -> DB : INSERT audit_log\nLOGIN_SUCCESS_ADMIN (append-only)
  AUTH --> FE : 200 { token, role, expiresIn }
  FE --> U : acceso al panel segun rol\n(admin = escritura · auditor = solo lectura)
else Credenciales invalidas
  AUTH -> DB : INSERT audit_log\nLOGIN_FAILURE_ADMIN (append-only)
  AUTH --> FE : 401 (mensaje generico)
  FE --> U : error de autenticacion
end
deactivate AUTH

== Camino B — Votante (cedula + PIN) ==

U -> FE : cedula + PIN
FE -> AUTH : POST /login/voter\n{cedula, pin}
activate AUTH
AUTH -> AUTH : voterLoginLimiter\n(rate limiting agresivo por IP)
AUTH -> AUTH : voterIdHash = SHA256(cedula + VOTER_ID_SALT)\ncedulaCifrada = encryptField(cedula)
AUTH -> DB : SELECT id, cedula, is_active, polling_place,\nvoting_table, access_code_hash\nFROM voters WHERE cedula = $1  <i>(cifrada)</i>
DB --> AUTH : fila del votante (o vacio)

alt No existe en el padron, o esta inactivo
  AUTH -> DB : INSERT audit_log LOGIN_FAILURE_VOTER\nactor_ref = voterIdHash · reason = no_encontrado_o_inactivo
  AUTH --> FE : 401 "Cedula o PIN incorrectos"
else Sin PIN asignado
  note right of AUTH
    Falla cerrado: un votante cargado
    antes de que existiera el PIN nunca
    vuelve a poder entrar con la cedula
    como contraseña. El admin debe
    generarle un PIN en "Padron".
  end note
  AUTH -> DB : INSERT audit_log LOGIN_FAILURE_VOTER\nreason = sin_pin_asignado
  AUTH --> FE : 401 "Cedula o PIN incorrectos"
else PIN incorrecto
  AUTH -> AUTH : bcrypt.compare(pin, access_code_hash) = false
  AUTH -> DB : INSERT audit_log LOGIN_FAILURE_VOTER\nreason = pin_incorrecto
  AUTH --> FE : 401 "Cedula o PIN incorrectos"
else PIN correcto
  AUTH -> AUTH : bcrypt.compare(pin, access_code_hash) = true
  AUTH -> AUTH : decryptField(polling_place, voting_table)
  AUTH -> AUTH : firma JWT { role: "voter", voterIdHash,\npollingPlace, votingTable }\nexp = VOTER_JWT_EXPIRES_IN (10 min)
  AUTH -> DB : INSERT audit_log LOGIN_SUCCESS_VOTER\nactor_ref = voterIdHash (nunca la cedula)
  AUTH --> FE : 200 { token, role: "voter",\npollingPlace, votingTable }
  FE --> U : boleta de la eleccion activa
end
deactivate AUTH

note over AUTH, DB
  Los tres fallos devuelven el MISMO 401 generico:
  no se distingue "cedula inexistente" de "PIN incorrecto",
  para no dar pistas a quien intente enumerar el padron.

  El audit_log nunca guarda PII cruda: el actor se
  identifica siempre por el hash SHA-256 de la cedula.
end note

@enduml
