@startuml componentes
' =============================================================================
' LiveMetric — Diagrama de Componentes
' Ubicacion sugerida en el repo: docs/arquitectura/componentes.puml
' Render: plantuml -tsvg docs/arquitectura/componentes.puml
' =============================================================================

title LiveMetric — Diagrama de Componentes

skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam ArrowFontSize 11
skinparam component {
  BackgroundColor #FDFDFD
  BorderColor #555555
}
skinparam package {
  BackgroundColor #F6F8FA
  BorderColor #999999
}

actor "Administrador" as ADMIN
actor "Auditor" as AUDITOR
actor "Votante" as VOTER

package "Navegador del usuario" {
  [Frontend SPA\nReact 18 + Vite\nservido por nginx] as FE
  note bottom of FE
    La sesion (JWT) vive solo en
    memoria de React: no se usa
    localStorage ni sessionStorage.
  end note
}

package "Capa de aplicacion — red app-net" {

  [Auth Service\nNode.js / Express] as AUTH
  [Voting Service\nNode.js / Express] as VOTING
  [Analytics Service\nNode.js / Express] as ANALYTICS
  [Scrutiny Service\nNode.js / Express] as SCRUTINY
  [Scheduler Worker\nNode.js + node-cron] as SCHEDULER

  interface "HTTP :3001" as I_AUTH
  interface "HTTP :3002" as I_VOTING
  interface "HTTP :3003" as I_ANALYTICS
  interface "HTTP :3004" as I_SCRUTINY

  I_AUTH -down- AUTH
  I_VOTING -down- VOTING
  I_ANALYTICS -down- ANALYTICS
  I_SCRUTINY -down- SCRUTINY
}

database "PostgreSQL\nadmins · voters · templates\nelections · votes\nscrutiny_ledger · audit_log" as DB

' ---------------------------------------------------------------------------
' Interacciones de los actores
' ---------------------------------------------------------------------------
ADMIN --> FE : gestiona plantillas,\nelecciones y padron
AUDITOR --> FE : consulta resultados\ny auditoria (solo lectura)
VOTER --> FE : se autentica y vota

' ---------------------------------------------------------------------------
' El SPA llama directo a cada microservicio (no hay API Gateway intermedio);
' por eso cada backend valida CORS contra FRONTEND_ORIGIN exacto.
' ---------------------------------------------------------------------------
FE --> I_AUTH : POST /login/admin\nPOST /login/voter\nGET /admin/audit-log\nPOST /admin/voters/bulk
FE --> I_VOTING : POST /vote\nGET /elections/active\nPOST /admin/elections
FE --> I_ANALYTICS : GET /api/elections/{id}/results\nGET /api/elections/{id}/metrics/*
FE --> I_SCRUTINY : GET /verify\nGET /certifications/{id}\nGET /certifications/{id}/acta.pdf

' ---------------------------------------------------------------------------
' Comunicacion interna entre servicios
' ---------------------------------------------------------------------------
SCHEDULER --> I_SCRUTINY : POST /internal/certify/{electionId}\n<b>X-Internal-Token</b> (comparacion timing-safe)

' ---------------------------------------------------------------------------
' Persistencia
' ---------------------------------------------------------------------------
AUTH --> DB : admins, voters (PII cifrada),\nescribe audit_log (append-only)
VOTING --> DB : templates, elections,\nvotes (UNIQUE por voter_id_hash)
ANALYTICS --> DB : lectura de votes (en vivo)\ny de scrutiny_ledger (certificado)
SCRUTINY --> DB : recuento independiente de votes,\nescribe scrutiny_ledger (append-only)
SCHEDULER --> DB : transiciona elections\nscheduled -> active -> closed

note right of SCRUTINY
  Escrutinio separado de Analytics
  a proposito: certificar resultados
  es una responsabilidad distinta a
  servirlos. Scrutiny recuenta desde
  cero sin confiar en Analytics.
end note

note bottom of DB
  Triggers a nivel de motor bloquean
  UPDATE/DELETE sobre scrutiny_ledger
  y audit_log: la inmutabilidad no
  depende del codigo de aplicacion.
end note

@enduml
