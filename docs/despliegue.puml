@startuml despliegue
' =============================================================================
' LiveMetric — Diagrama de Despliegue (contenedores, redes y volumenes)
' Ubicacion sugerida en el repo: docs/arquitectura/despliegue.puml
' Render: plantuml -tsvg docs/arquitectura/despliegue.puml
'
' IMPORTANTE — este diagrama refleja el estado ACTUAL de docker-compose.yml,
' donde el servicio "postgres" es un proxy TCP (socat) hacia Supabase.
' El camino de Terraform (infra/terraform/main.tf) levanta en cambio un
' PostgreSQL local con volumen "livemetric_pgdata" y red "db-net" interna.
' Cuando el equipo unifique los dos caminos, actualizar ESTE archivo:
' al final hay un bloque comentado con la variante 100% local.
' =============================================================================

title LiveMetric — Diagrama de Despliegue (entorno local con Docker Compose)

skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam node {
  BackgroundColor #F6F8FA
  BorderColor #666666
}
skinparam rectangle {
  BackgroundColor #FDFDFD
  BorderColor #555555
}

node "Equipo del usuario" as CLIENT {
  artifact "Navegador web" as BROWSER
}

node "Host anfitrion\nDocker Engine + Docker Compose v2" as HOST {

  rectangle "Red **app-net** (bridge)" as APPNET {

    node "livemetric-frontend" as C_FE {
      artifact "nginx + build de Vite\nimagen: livemetric/frontend-service\nescucha :8080 (no-root en workers)"
    }

    node "livemetric-auth" as C_AUTH {
      artifact "Node.js 20 alpine\nimagen: livemetric/auth-service\nusuario no-root · read_only · tmpfs /tmp"
    }

    node "livemetric-voting" as C_VOTING {
      artifact "Node.js 20 alpine\nimagen: livemetric/voting-service\nusuario no-root · read_only · tmpfs /tmp"
    }

    node "livemetric-analytics" as C_ANALYTICS {
      artifact "Node.js 20 alpine\nimagen: livemetric/analytics-service\nusuario no-root · read_only · tmpfs /tmp"
    }

    node "livemetric-scrutiny" as C_SCRUTINY {
      artifact "Node.js 20 alpine\nimagen: livemetric/scrutiny-service\nusuario no-root · read_only · tmpfs /tmp"
    }

    node "livemetric-scheduler" as C_SCHED {
      artifact "Node.js 20 alpine + node-cron\nimagen: livemetric/scheduler-service\n<b>sin puertos publicados</b>"
    }

    node "livemetric-postgres\n(proxy TCP socat)" as C_PROXY {
      artifact "alpine/socat\nTCP-LISTEN:5432 -> Supabase\nno termina TLS (E2E hasta Supabase)"
    }
  }
}

cloud "Supabase (PostgreSQL gestionado)" as SUPA {
  database "postgres\nTLS verificado contra\nsupabase-root-2021.crt" as DB
}

' ---------------------------------------------------------------------------
' Puertos publicados en el host
' ---------------------------------------------------------------------------
BROWSER --> C_FE : <b>0.0.0.0:3000</b> -> :8080\nHTTP
BROWSER --> C_AUTH : <b>127.0.0.1:3001</b> -> :3001
BROWSER --> C_VOTING : <b>127.0.0.1:3002</b> -> :3002
BROWSER --> C_ANALYTICS : <b>127.0.0.1:3003</b> -> :3003
BROWSER --> C_SCRUTINY : <b>127.0.0.1:3004</b> -> :3004

note right of BROWSER
  Los 4 microservicios se publican
  SOLO en 127.0.0.1, nunca en 0.0.0.0:
  no son alcanzables desde la LAN.
end note

' ---------------------------------------------------------------------------
' Trafico interno
' ---------------------------------------------------------------------------
C_SCHED --> C_SCRUTINY : HTTP interno en app-net\nPOST /internal/certify/{id}\nX-Internal-Token

C_AUTH --> C_PROXY : pg :5432
C_VOTING --> C_PROXY : pg :5432
C_ANALYTICS --> C_PROXY : pg :5432
C_SCRUTINY --> C_PROXY : pg :5432
C_SCHED --> C_PROXY : pg :5432

C_PROXY --> DB : TLS extremo a extremo\n(el proxy solo reenvia bytes)

' ---------------------------------------------------------------------------
' Configuracion y secretos
' ---------------------------------------------------------------------------
artifact ".env (local, en .gitignore)\nJWT_SECRET · VOTER_ID_SALT\nINTERNAL_SERVICE_TOKEN\nSUPABASE_DB_*" as ENV
ENV ..> APPNET : inyectado como\nvariables de entorno

note bottom of APPNET
  Endurecimiento aplicado a todos los contenedores:
  security_opt: no-new-privileges:true
  read_only: true + tmpfs para /tmp
  usuario no-root (excepto el proceso maestro de nginx,
  cuyos workers si corren sin privilegios)
end note

' =============================================================================
' VARIANTE 100% LOCAL (la que construye infra/terraform/main.tf).
' Descomentar este bloque y eliminar el nodo C_PROXY y la nube SUPA cuando
' se unifiquen compose y Terraform sobre PostgreSQL en contenedor.
'
' rectangle "Red **db-net** (internal: true)" as DBNET {
'   node "livemetric-postgres" as C_DB {
'     artifact "postgres:16-alpine\nsin puertos publicados al host"
'   }
' }
' database "volumen livemetric_pgdata" as VOL
' C_DB --> VOL : /var/lib/postgresql/data
' =============================================================================

@enduml
