@startuml casos-de-uso
' =============================================================================
' LiveMetric — Diagrama de Casos de Uso
' Ubicacion sugerida en el repo: docs/arquitectura/casos-de-uso.puml
' Render: plantuml -tsvg docs/arquitectura/casos-de-uso.puml
' =============================================================================

title LiveMetric — Diagrama de Casos de Uso

left to right direction
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam usecase {
  BackgroundColor #FDFDFD
  BorderColor #555555
}
skinparam actorStyle awesome

actor "Administrador" as ADMIN
actor "Auditor" as AUDITOR
actor "Votante" as VOTER
actor "Scheduler\n(actor sistema)" as SCHED

rectangle "LiveMetric" {

  ' --- Autenticacion (transversal) ---
  usecase "Iniciar sesion\ncomo administrador" as UC_LOGIN_A
  usecase "Iniciar sesion\ncomo votante" as UC_LOGIN_V

  ' --- Gestion electoral ---
  usecase "Crear plantilla\n(generica o presidencial)" as UC_TPL
  usecase "Instanciar eleccion\ncon ventana de tiempo" as UC_ELECTION
  usecase "Detener eleccion\nmanualmente" as UC_STOP
  usecase "Cargar padron\nde votantes" as UC_PADRON
  usecase "Generar / resetear\nPIN de votante" as UC_PIN
  usecase "Crear usuario\nadministrador o auditor" as UC_USER

  ' --- Votacion ---
  usecase "Consultar eleccion\nactiva y su boleta" as UC_BOLETA
  usecase "Emitir voto" as UC_VOTE
  usecase "Verificar que\nya voto" as UC_MYVOTES

  ' --- Ciclo automatico ---
  usecase "Abrir eleccion\nal llegar su hora" as UC_OPEN
  usecase "Cerrar eleccion\nal vencer su ventana" as UC_CLOSE
  usecase "Certificar resultados\n(cadena de hashes)" as UC_CERTIFY

  ' --- Consulta y control ---
  usecase "Consultar resultados\n(en vivo o certificados)" as UC_RESULTS
  usecase "Consultar acta\npor mesa de votacion" as UC_ACTA
  usecase "Descargar acta\nen PDF" as UC_PDF
  usecase "Verificar integridad\nde la cadena de actas" as UC_VERIFY
  usecase "Consultar registro\nde auditoria" as UC_AUDIT
  usecase "Ver tableros con\nestadistica avanzada" as UC_DASH
}

' ---------------------------------------------------------------------------
' Administrador
' ---------------------------------------------------------------------------
ADMIN --> UC_LOGIN_A
ADMIN --> UC_TPL
ADMIN --> UC_ELECTION
ADMIN --> UC_STOP
ADMIN --> UC_PADRON
ADMIN --> UC_PIN
ADMIN --> UC_USER
ADMIN --> UC_RESULTS
ADMIN --> UC_VERIFY
ADMIN --> UC_AUDIT
ADMIN --> UC_DASH

' ---------------------------------------------------------------------------
' Auditor — mismo login, permisos de solo lectura
' ---------------------------------------------------------------------------
AUDITOR --> UC_LOGIN_A
AUDITOR --> UC_RESULTS
AUDITOR --> UC_ACTA
AUDITOR --> UC_PDF
AUDITOR --> UC_VERIFY
AUDITOR --> UC_AUDIT
AUDITOR --> UC_DASH

' ---------------------------------------------------------------------------
' Votante
' ---------------------------------------------------------------------------
VOTER --> UC_LOGIN_V
VOTER --> UC_BOLETA
VOTER --> UC_VOTE
VOTER --> UC_MYVOTES

' ---------------------------------------------------------------------------
' Scheduler — actor sistema, sin intervencion humana
' ---------------------------------------------------------------------------
SCHED --> UC_OPEN
SCHED --> UC_CLOSE
SCHED --> UC_CERTIFY

' ---------------------------------------------------------------------------
' Relaciones entre casos de uso
' ---------------------------------------------------------------------------
UC_TPL ..> UC_LOGIN_A : <<include>>
UC_ELECTION ..> UC_LOGIN_A : <<include>>
UC_ELECTION ..> UC_TPL : <<include>>
UC_PADRON ..> UC_LOGIN_A : <<include>>
UC_PIN ..> UC_PADRON : <<extend>>
UC_STOP ..> UC_CLOSE : <<extend>>

UC_VOTE ..> UC_LOGIN_V : <<include>>
UC_VOTE ..> UC_BOLETA : <<include>>

UC_CLOSE ..> UC_CERTIFY : <<include>>
UC_ACTA ..> UC_CERTIFY : <<include>>
UC_PDF ..> UC_ACTA : <<extend>>
UC_RESULTS ..> UC_CERTIFY : <<extend>>

note bottom of UC_VOTE
  Triple defensa contra doble voto:
  JWT de identidad + transaccion +
  restriccion UNIQUE sobre voter_id_hash.
  El JWT de administrador NO sirve para votar.
end note

note bottom of UC_CERTIFY
  Ejecutado solo por Scheduler via
  POST /internal/certify/{id} con
  X-Internal-Token. Ningun JWT de
  usuario puede disparar este caso de uso.
end note

@enduml
