# Entorno y secretos
.env
*.env.local
# ".env.gpg" NO va aquí a propósito: es el .env cifrado que sí está pensado
# para compartirse/commitearse (ver scripts/deploy.sh) — el secreto real es
# la passphrase de gpg, que nunca vive en este repo.

# Node
node_modules/
npm-debug.log*
services/**/node_modules/
services/frontend/dist/

# Terraform
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/.terraform.lock.hcl
infra/terraform/crash.log
infra/terraform/*.tfvars

# Reportes de seguridad generados por el pipeline
reports/
trivy-report.json
checkov-report.json
gitleaks-report.json

# Varios
.DS_Store
*.log
