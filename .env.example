# Copia este archivo a ".env" y reemplaza los valores.
# ".env" esta en .gitignore y NUNCA debe subirse al repositorio.

# --- PostgreSQL (Supabase) ---
# Usa el "Session Pooler" (Project Settings -> Database -> Connection
# Pooling), NO la conexion "Direct": esta ultima resuelve solo a IPv6 y no es
# alcanzable desde la red Docker de este stack (IPv4). El pooler si acepta
# IPv4. El usuario del pooler incluye el project-ref: postgres.<project-ref>.
SUPABASE_DB_HOST=aws-0-xx-xxxx-x.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.xxxxxxxxxxxxxxxxxxxx
SUPABASE_DB_PASSWORD=CAMBIA_ESTE_VALOR_LOCALMENTE
# Supabase exige TLS en la conexion a Postgres.
DB_SSL=true

# --- JWT (compartido entre todos los servicios que verifican tokens) ---
# Genera un valor fuerte, por ejemplo con: openssl rand -base64 48
JWT_SECRET=CAMBIA_ESTE_VALOR_LOCALMENTE
JWT_EXPIRES_IN=1h
# Vida del token de VOTANTE: intencionalmente corta (minutos), alcanza para
# emitir un voto pero limita la ventana de uso indebido si se filtrara.
VOTER_JWT_EXPIRES_IN=10m

# --- Padrón electoral: hash de identidad del votante ---
# Salt privado, conocido SOLO por auth-service. Se usa para calcular
# SHA-256(cedula + salt) y así nunca almacenar ni propagar la cédula en
# texto plano fuera de la tabla "voters".
VOTER_ID_SALT=CAMBIA_ESTE_VALOR_LOCALMENTE

# --- Cifrado en reposo del padrón (columnas cedula/polling_place/voting_table
# de "voters"; full_name queda en texto plano) ---
# Clave AES-256 en base64 (32 bytes), ej: openssl rand -base64 32.
# La conocen SOLO auth-service y analytics-service (los dos únicos que leen
# "voters" directamente). Si se pierde, esos datos quedan irrecuperables.
VOTERS_ENCRYPTION_KEY=CAMBIA_ESTE_VALOR_LOCALMENTE

# --- Comunicacion interna servicio-a-servicio (scheduler-worker <-> scrutiny-service) ---
INTERNAL_SERVICE_TOKEN=CAMBIA_ESTE_VALOR_LOCALMENTE

# --- Worker de cierre automatico de elecciones ---
# Expresion cron estandar (minuto hora dia mes dia_semana). Por defecto: cada minuto.
SCHEDULER_CRON=* * * * *

# --- CORS: origen exacto permitido para llamar a los microservicios desde
# el navegador. Debe coincidir con el puerto donde corre el frontend.
FRONTEND_ORIGIN=http://localhost:3000
