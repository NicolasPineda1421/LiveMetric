# Plantilla del .env. No hace falta copiarla a mano: si no hay .env,
# scripts/start.sh, start.bat y contenedor.sh lo generan solos a partir de
# este archivo, con secretos aleatorios propios de esa instalación
# (scripts/lib/generar-env.js). ".env" está en .gitignore y NUNCA debe subirse.
#
# Si lo armas a mano, reemplaza cada CAMBIA_ESTE_VALOR_LOCALMENTE por un valor
# aleatorio distinto (por ejemplo: openssl rand -base64 48), salvo el par
# ACTA_SIGNING_KEY / ACTA_PUBLIC_KEY, que tiene que generarlo el script.
#
# Importante: la base guarda datos cifrados con VOTERS_ENCRYPTION_KEY y se
# inicializa con POSTGRES_PASSWORD. Si pierdes o regeneras este archivo,
# borra también el volumen de la base (docker compose down -v) o los datos
# existentes quedan ilegibles.

# --- PostgreSQL local (contenedor "postgres" de docker-compose.yml) ---
POSTGRES_DB=livemetric
POSTGRES_USER=livemetric
POSTGRES_PASSWORD=CAMBIA_ESTE_VALOR_LOCALMENTE

# --- JWT (compartido entre todos los servicios que verifican tokens) ---
JWT_SECRET=CAMBIA_ESTE_VALOR_LOCALMENTE
JWT_EXPIRES_IN=1h
# Vida del token de VOTANTE: intencionalmente corta (minutos), alcanza para
# emitir un voto pero limita la ventana de uso indebido si se filtrara.
VOTER_JWT_EXPIRES_IN=10m

# --- Vigencia del PIN del votante ---
# Horas que vale cada PIN desde que se genera (al agregar al votante o al
# regenerarlo), haya o no una elección: de 1 a 2160 (90 días). Conviene
# generar y entregar los PIN poco antes de la elección.
PIN_VIGENCIA_HORAS=24

# --- Padrón electoral: hash de identidad del votante ---
# Sal privada, conocida SOLO por auth-service. Se usa para calcular
# SHA-256(cedula + sal) y así nunca almacenar ni propagar la cédula en
# texto plano fuera de la tabla "voters".
VOTER_ID_SALT=CAMBIA_ESTE_VALOR_LOCALMENTE

# --- Cifrado en reposo del padrón (cedula, polling_place y voting_table de
# "voters"; full_name queda en texto plano) ---
# Clave AES-256 en base64: exactamente 32 bytes (openssl rand -base64 32).
# La conocen SOLO auth-service y analytics-service. Si se pierde, esos datos
# quedan irrecuperables.
VOTERS_ENCRYPTION_KEY=CAMBIA_ESTE_VALOR_LOCALMENTE

# --- Comunicación interna servicio a servicio (scheduler-worker <-> scrutiny-service) ---
INTERNAL_SERVICE_TOKEN=CAMBIA_ESTE_VALOR_LOCALMENTE

# --- Firma digital de las actas de escrutinio (Ed25519) ---
# Van en pareja: scripts/lib/generar-env.js genera la privada y deriva de
# ella la pública. ACTA_SIGNING_KEY es la PRIVADA: la conoce solo
# scrutiny-service, que firma cada acta al certificarla. ACTA_PUBLIC_KEY
# es la pública: con ella analytics-service comprueba que cada acta la
# emitió esta instalación y que no cambió. Si se pierden o se regeneran,
# las actas ya firmadas dejan de verificarse.
ACTA_SIGNING_KEY=CAMBIA_ESTE_VALOR_LOCALMENTE
ACTA_PUBLIC_KEY=SE_DERIVA_DE_ACTA_SIGNING_KEY

# --- Worker de cierre automático de elecciones ---
# Expresión cron estándar (minuto hora día mes día_semana). Por defecto: cada
# minuto. Entre comillas: sin ellas, orquestacion/deploy.sh (que carga este
# archivo con bash) interpretaría los asteriscos.
SCHEDULER_CRON="* * * * *"

# --- CORS: origen exacto permitido para llamar a los microservicios desde
# el navegador. Debe coincidir con el puerto donde corre el frontend.
FRONTEND_ORIGIN=http://localhost:3000

# --- Grafana del stack de monitoreo (monitoring/): usuario y contraseña del
# administrador. Sin contraseña, ese compose no arranca: la de fábrica de
# Grafana es pública. ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CAMBIA_ESTE_VALOR_LOCALMENTE

# --- Docker Hub: de dónde descarga las imágenes el despliegue con Swarm
# (orquestacion/deploy.sh). ---
DOCKERHUB_NAMESPACE=nicolaspineda1421
